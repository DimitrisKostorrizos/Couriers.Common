<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Title>Courier API Clients's Common Types</Title>
		<Authors>Dimitrios Kostorrizos</Authors>
		<Description>Contains the common types used across the Courier Client packages.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DimitrisKostorrizos/Couriers.Common</RepositoryUrl>
		<PackageProjectUrl>https://github.com/DimitrisKostorrizos/Couriers.Common</PackageProjectUrl>
		<PackageTags>Courier;API</PackageTags>
		<PackageVersion>1.0.0</PackageVersion>
	</PropertyGroup>

	<Choose>
		<When Condition="'$(Configuration)'=='Debug'">
			<PropertyGroup>
				<AnalysisLevel>latest-Recommended</AnalysisLevel>
			</PropertyGroup>
		</When>
		<When Condition="'$(Configuration)'=='Release'">
			<PropertyGroup>
				<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
				<Optimize>true</Optimize>
			</PropertyGroup>
		</When>
	</Choose>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
		</None>
	</ItemGroup>
</Project>
